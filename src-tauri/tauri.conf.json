{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Downloader",
  "mainBinaryName": "media-downloader",
  "version": "5.1.2",
  "identifier": "com.mediadownloader.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Media Downloader",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:4321",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Pierre Mouilleseaux Lhuillier",
    "copyright": "© 2026 Pierre Mouilleseaux Lhuillier",
    "shortDescription": "Téléchargeur d'images et de vidéos (Google Images, X, Reddit)",
    "longDescription": "Application de bureau pour télécharger des images et des vidéos depuis Google Images, les likes X et les enregistrés Reddit, avec conversion automatique via ffmpeg.",
    "homepage": "https://github.com/Pierre-ML/img_download",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi",
        "languages": ["French", "English"]
      }
    }
  }
}
