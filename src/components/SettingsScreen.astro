---
const toggleCls =
  "peer h-6 w-11 shrink-0 cursor-pointer appearance-none rounded-full bg-surface-3 transition-colors checked:bg-accent relative " +
  "before:absolute before:left-0.5 before:top-0.5 before:h-5 before:w-5 before:rounded-full before:bg-white before:transition-transform before:content-[''] checked:before:translate-x-5";
---

<section data-screen="settings" class="mx-auto w-full max-w-2xl" hidden>
  <h1 class="text-xl font-semibold tracking-tight">Réglages</h1>
  <p class="mt-1 mb-5 text-sm text-muted">Dossier de destination et traitement des médias.</p>
  <div class="card flex flex-col gap-5">
    <div>
      <label class="label" for="set-dest">Dossier de destination</label>
      <div class="flex gap-2">
        <input id="set-dest" class="field" type="text" />
        <button id="set-choose" type="button" class="btn-ghost shrink-0">Choisir…</button>
        <button id="set-open" type="button" class="btn-ghost shrink-0">Ouvrir le dossier</button>
      </div>
    </div>

    <div class="flex items-center justify-between gap-4">
      <div>
        <label class="label !mb-0" for="set-parallel">Téléchargements parallèles</label>
        <span class="text-xs text-muted">De 1 à 16</span>
      </div>
      <input id="set-parallel" class="field !w-24 text-center" type="number" min="1" max="16" value="4" />
    </div>

    <div class="flex items-center justify-between gap-4">
      <div>
        <label class="label !mb-0" for="set-png">Optimiser les PNG</label>
        <span class="text-xs text-muted">Compression sans perte (oxipng), plus lent mais plus léger</span>
      </div>
      <input id="set-png" type="checkbox" class={toggleCls} checked />
    </div>

    <div class="flex items-center justify-between gap-4">
      <div>
        <label class="label !mb-0" for="set-reencode">Ré-encoder les vidéos</label>
        <span class="text-xs text-muted">Convertit en MP4 H.264 ; sinon la vidéo est simplement copiée si possible</span>
      </div>
      <input id="set-reencode" type="checkbox" class={toggleCls} checked />
    </div>

    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <label class="label !mb-0" for="set-crf">Qualité vidéo (CRF)</label>
        <span id="set-crf-val" class="text-sm font-medium tabular-nums text-accent">23</span>
      </div>
      <input id="set-crf" type="range" min="18" max="35" step="1" value="23" class="w-full accent-accent disabled:opacity-40" />
      <div class="mt-1 flex justify-between text-[11px] text-muted"><span>18 · meilleure qualité</span><span>35 · plus léger</span></div>
    </div>

    <div class="flex justify-end border-t border-line pt-4">
      <button id="set-save" type="button" class="btn-primary">Enregistrer</button>
    </div>
  </div>
  <div class="card mt-5 flex flex-col gap-4">
    <div class="flex items-center justify-between gap-4">
      <div>
        <span class="label !mb-0">Mises à jour</span>
        <span class="text-xs text-muted">Version actuelle : <span id="upd-current" class="font-medium text-ink">—</span></span>
      </div>
      <div class="flex gap-2">
        <button id="upd-notes" type="button" class="btn-ghost shrink-0" hidden>Notes de version</button>
        <button id="upd-install" type="button" class="btn-primary shrink-0" hidden>Installer</button>
        <button id="upd-check" type="button" class="btn-ghost shrink-0">Vérifier les mises à jour</button>
      </div>
    </div>
    <p id="upd-status" class="text-sm text-muted" role="status"></p>
    <div id="upd-progress" hidden>
      <progress id="upd-progress-bar" class="h-2 w-full overflow-hidden rounded-full accent-accent" max="1"></progress>
      <p id="upd-progress-text" class="mt-1.5 text-xs text-muted"></p>
    </div>
  </div>
</section>
