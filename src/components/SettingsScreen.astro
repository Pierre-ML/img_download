---
import ScreenHeader from './ScreenHeader.astro';
---

<section data-screen="settings" class="mx-auto w-full max-w-2xl" hidden>
  <ScreenHeader animal="cerf" title="Réglages" description="Dossier de destination et traitement des médias." />
  <div class="panel flex flex-col gap-5">
    <div>
      <label class="field-label" for="set-dest">Dossier de destination</label>
      <div class="flex gap-2">
        <input id="set-dest" class="field" type="text" />
        <button id="set-choose" type="button" class="button-ghost shrink-0">Choisir…</button>
        <button id="set-open" type="button" class="button-ghost shrink-0">Ouvrir le dossier</button>
      </div>
    </div>

    <div class="flex items-center justify-between gap-4">
      <div>
        <label class="field-label !mb-0" for="set-parallel">Téléchargements parallèles</label>
        <span class="text-xs text-muted">De 1 à 16</span>
      </div>
      <input id="set-parallel" class="field !w-24 text-center" type="number" min="1" max="16" value="4" />
    </div>

    <div class="border-t border-border pt-4">
      <span class="field-label">Formats de sortie</span>
      <div class="rounded-lg border border-border bg-bg p-3 text-xs text-muted">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-fg">Meilleure qualité</span>
          <span class="pill">PNG (images)</span>
          <span class="pill">MP4 H.264 sans ré-encodage (vidéos)</span>
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <span class="text-fg">Plus léger</span>
          <span class="pill">AVIF (images)</span>
          <span class="pill">WebM AV1 (vidéos)</span>
        </div>
        <p class="mt-2">
          PNG est sans perte mais lourd. AVIF est environ 50 % plus léger que JPG à qualité égale. AV1 est 30 à 50 % plus léger que H.264 mais l'encodage est plus lent. WebP et H.265 sont de bons compromis.
        </p>
      </div>
    </div>

    <div>
      <label class="field-label" for="set-image-format">Format des images</label>
      <select id="set-image-format" class="field">
        <option value="png">PNG — sans perte, qualité maximale</option>
        <option value="jpg">JPG — compatible partout</option>
        <option value="webp">WebP — bon compromis</option>
        <option value="avif">AVIF — le plus léger</option>
      </select>
    </div>

    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <label class="field-label !mb-0" for="set-image-quality">Qualité des images</label>
        <span id="set-image-quality-val" class="text-sm font-medium tabular-nums">85</span>
      </div>
      <input id="set-image-quality" type="range" min="50" max="100" step="1" value="85" class="w-full accent-fg disabled:opacity-40" />
      <div class="mt-1 flex justify-between text-[11px] text-muted"><span>50 · plus léger</span><span>100 · meilleure qualité</span></div>
    </div>

    <div class="flex items-center justify-between gap-4">
      <div>
        <label class="field-label !mb-0" for="set-png">Optimiser les PNG</label>
        <span class="text-xs text-muted">Compression sans perte (oxipng), plus lent mais plus léger. Uniquement pour le format PNG.</span>
      </div>
      <input id="set-png" type="checkbox" class="toggle-switch" checked />
    </div>

    <div>
      <label class="field-label" for="set-video-format">Format des vidéos</label>
      <select id="set-video-format" class="field">
        <option value="h264">MP4 H.264 — qualité et compatibilité maximales</option>
        <option value="h265">MP4 H.265 — ~40 % plus léger, même qualité</option>
        <option value="vp9">WebM VP9 — léger, standard du web</option>
        <option value="av1">WebM AV1 — le plus léger, encodage lent</option>
      </select>
    </div>

    <div class="flex items-center justify-between gap-4">
      <div>
        <label class="field-label !mb-0" for="set-reencode">Ré-encoder les vidéos</label>
        <span id="set-reencode-help" class="text-xs text-muted">Convertit en MP4 H.264 ; sinon la vidéo est simplement copiée si possible</span>
      </div>
      <input id="set-reencode" type="checkbox" class="toggle-switch" checked />
    </div>

    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <label class="field-label !mb-0" for="set-crf">Qualité vidéo (CRF)</label>
        <span id="set-crf-val" class="text-sm font-medium tabular-nums">23</span>
      </div>
      <input id="set-crf" type="range" min="18" max="35" step="1" value="23" class="w-full accent-fg disabled:opacity-40" />
      <div class="mt-1 flex justify-between text-[11px] text-muted"><span>18 · meilleure qualité</span><span>35 · plus léger</span></div>
    </div>

    <div class="flex justify-end border-t border-border pt-4">
      <button id="set-save" type="button" class="button-primary">Enregistrer</button>
    </div>
  </div>
  <div class="panel mt-5 flex flex-col gap-4">
    <div class="flex items-center justify-between gap-4">
      <div>
        <span class="field-label !mb-0">Mises à jour</span>
        <span class="text-xs text-muted">Version actuelle : <span id="upd-current" class="font-medium text-fg">—</span></span>
      </div>
      <div class="flex gap-2">
        <button id="upd-notes" type="button" class="button-ghost shrink-0" hidden>Notes de version</button>
        <button id="upd-install" type="button" class="button-primary shrink-0" hidden>Installer</button>
        <button id="upd-check" type="button" class="button-ghost shrink-0">Vérifier les mises à jour</button>
      </div>
    </div>
    <p id="upd-status" class="text-sm text-muted" role="status"></p>
    <div id="upd-progress" hidden>
      <progress id="upd-progress-bar" class="h-1 w-full overflow-hidden rounded-full [&::-moz-progress-bar]:bg-fg [&::-webkit-progress-bar]:bg-fg/10 [&::-webkit-progress-value]:bg-fg" max="1"></progress>
      <p id="upd-progress-text" class="mt-1.5 text-xs text-muted"></p>
    </div>
  </div>
  <div class="panel mt-5 flex items-center justify-between gap-4">
    <div>
      <span class="field-label !mb-0">Désinstaller l'application</span>
      <span class="text-xs text-muted">Supprime Lucascrap de cet ordinateur. Les médias téléchargés sont conservés.</span>
    </div>
    <button id="app-uninstall" type="button" class="button-danger shrink-0">Désinstaller</button>
  </div>
</section>
