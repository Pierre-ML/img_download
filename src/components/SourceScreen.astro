---
import ScreenHeader from './ScreenHeader.astro';

interface Props {
  id: 'x' | 'reddit';
  animal: string;
  title: string;
  description: string;
  account: string;
  action: string;
}
const { id, animal, title, description, account, action } = Astro.props;
---

<section data-screen={id} class="mx-auto w-full max-w-2xl" hidden>
  <ScreenHeader animal={animal} title={title} description={description} />
  <div class="panel flex flex-col gap-4">
    <div class="flex items-center justify-between gap-3">
      <div>
        <span class="field-label !mb-0.5">Compte {account}</span>
        <span id={`${id}-status`} class="text-sm text-muted">Non connecté</span>
      </div>
      <button id={`${id}-connect`} type="button" class="button-ghost">Connecter {account}</button>
    </div>
    <div class="flex flex-wrap items-end gap-4 border-t border-border pt-4">
      <div class="w-32">
        <label class="field-label" for={`${id}-limit`}>Limite (0 = tout)</label>
        <input id={`${id}-limit`} class="field" type="number" min="0" value="0" />
      </div>
      <div class="w-40">
        <label class="field-label" for={`${id}-image-format`}>Images</label>
        <select id={`${id}-image-format`} class="field" data-format="image"></select>
      </div>
      <div class="w-40">
        <label class="field-label" for={`${id}-video-format`}>Vidéos</label>
        <select id={`${id}-video-format`} class="field" data-format="video"></select>
      </div>
      <button id={`${id}-add`} type="button" class="button-primary ml-auto" disabled>{action}</button>
    </div>
  </div>
</section>
