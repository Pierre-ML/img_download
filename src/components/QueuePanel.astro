---
import Animal from './Animal.astro';
---

<aside class="flex w-[360px] shrink-0 flex-col border-l border-border bg-surface">
  <section class="flex min-h-0 flex-[3] flex-col">
    <header class="flex items-center justify-between px-4 py-3">
      <h2 class="text-sm font-medium">File d'attente</h2>
      <button id="queue-clear" type="button" class="rounded-md px-2 py-1 text-xs text-muted transition-colors hover:bg-white/5 hover:text-fg disabled:opacity-40" disabled>Vider terminés</button>
    </header>
    <div class="min-h-0 flex-1 overflow-y-auto px-4 pb-3">
      <div id="queue-list" class="flex flex-col gap-2.5"></div>
      <div id="queue-empty" class="flex flex-col items-center py-8 text-center">
        <Animal id="pie" class="mb-3 size-14 shrink-0 text-fg/25" />
        <p class="text-sm text-muted">Aucun téléchargement.</p>
      </div>
    </div>
  </section>

  <section class="flex min-h-0 flex-[2] flex-col border-t border-border">
    <header class="flex items-center justify-between px-4 py-2.5">
      <h2 class="text-sm font-medium">Journal</h2>
      <button id="log-clear" type="button" class="rounded-md px-2 py-1 text-xs text-muted transition-colors hover:bg-white/5 hover:text-fg">Effacer</button>
    </header>
    <div id="log-list" class="min-h-0 flex-1 overflow-y-auto bg-code px-4 py-2 font-mono text-[11px] leading-relaxed"></div>
  </section>
</aside>
