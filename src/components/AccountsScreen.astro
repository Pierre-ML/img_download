---
import ScreenHeader from './ScreenHeader.astro';

const providers = [
  { id: 'x', name: 'X', desc: 'Nécessaire pour télécharger vos likes.' },
  { id: 'reddit', name: 'Reddit', desc: 'Nécessaire pour télécharger vos posts enregistrés.' },
];
---

<section data-screen="accounts" class="mx-auto w-full max-w-2xl" hidden>
  <ScreenHeader animal="aigle" title="Comptes" description="La connexion s'effectue dans une fenêtre intégrée ; vos cookies restent chiffrés sur cet ordinateur." />
  <div class="grid gap-4 sm:grid-cols-2">
    {providers.map((p) => (
      <div class="panel flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <span id={`acc-${p.id}-dot`} class="size-2.5 rounded-full bg-border"></span>
          <h2 class="font-medium">{p.name}</h2>
        </div>
        <div>
          <div id={`acc-${p.id}-status`} class="text-sm text-muted">Non connecté</div>
          <p class="mt-1 text-xs text-muted">{p.desc}</p>
        </div>
        <div class="mt-auto flex">
          <button id={`acc-${p.id}-login`} type="button" class="button-primary">Connecter {p.name}</button>
          <button id={`acc-${p.id}-logout`} type="button" class="button-danger" hidden>Déconnecter</button>
        </div>
      </div>
    ))}
  </div>
</section>
